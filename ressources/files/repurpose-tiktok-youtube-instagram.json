    {
      "parameters": {
        "jsCode": "// Extrait l'URL de lecture directe de la vidéo TikTok.\n// Cette URL (playAddr) pointe vers le master SANS watermark :\n// c'est le fichier que TikTok sert au lecteur web, pas l'export \"Enregistrer\".\nconst html = $input.first().json.data;\nconst headers = $input.first().json.headers || {};\nconst cookies = headers['set-cookie'] || [];\n\nif (!html) {\n  throw new Error(\"Corps HTML vide. Verifie que le noeud precedent renvoie du texte (responseFormat: text + fullResponse).\");\n}\n\nconst regex = /<script id=\"__UNIVERSAL_DATA_FOR_REHYDRATION__\" type=\"application\\/json\">([\\s\\S]*?)<\\/script>/;\nconst match = html.match(regex);\n\nif (!match) {\n  throw new Error(\"Bloc __UNIVERSAL_DATA_FOR_REHYDRATION__ introuvable. TikTok a servi une page anti-bot : change le User-Agent ou reessaie.\");\n}\n\nconst data = JSON.parse(match[1]);\nconst item = data?.__DEFAULT_SCOPE__?.['webapp.video-detail']?.itemInfo?.itemStruct;\n\nconst videoUrl = item?.video?.playAddr;\nif (!videoUrl) {\n  throw new Error(\"playAddr absent : la video est peut-etre privee ou supprimee.\");\n}\n\nlet description = (item?.desc || '').replace(/\\r?\\n|\\r/g, ' ').trim();\n\nreturn [{\n  json: {\n    videoUrl,\n    description,\n    tiktokId: item?.id || '',\n    // Les cookies de la page sont OBLIGATOIRES pour telecharger le fichier :\n    // sans eux le CDN renvoie un 403.\n    cookies: Array.isArray(cookies) ? cookies.join('; ') : String(cookies)\n  }\n}];\n"
      },
      "name": "Extraire la vidéo sans watermark",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        320
