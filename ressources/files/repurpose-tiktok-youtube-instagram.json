        "contentType": "raw",
        "rawContentType": "RAW/JSON",
        "body": "={\n  \"snippet\": {\n    \"title\": \"{{ $json.ytTitle }}\",\n    \"description\": \"{{ $json.ytDescription }}\",\n    \"tags\": \"{{ $json.ytTags }}\",\n    \"categoryId\": \"22\",\n    \"defaultLanguage\": \"fr\",\n    \"defaultAudioLanguage\": \"fr\"\n  },\n  \"status\": {\n    \"privacyStatus\": \"private\",\n    \"license\": \"youtube\",\n    \"embeddable\": true,\n    \"selfDeclaredMadeForKids\": false,\n    \"publishAt\": \"{{ $now.plus({ hours: 1 }).setZone('UTC').toFormat(\"yyyy-MM-dd'T'HH:mm:ss'Z'\") }}\"\n  }\n}",
        "options": {
