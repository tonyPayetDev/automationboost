      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $input.all().map(i => {\n  const r = i.json;\n  return { json: {\n    nom: r.title || \"\",\n    adresse: r.address || \"\",\n    telephone: r.phone || \"\",\n    siteWeb: r.website || \"\",\n    note: r.totalScore || 0,\n    nbAvis: r.reviewsCount || 0,\n    email: (r.emails && r.emails[0]) || \"\"\n  } };\n});"
      }
    },
