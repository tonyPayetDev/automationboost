      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=Restaurant : {{ $('Garder les fiches contactables').item.json.nom }}\nAdresse : {{ $('Garder les fiches contactables').item.json.adresse }}\nNote Google : {{ $('Garder les fiches contactables').item.json.note }} sur {{ $('Garder les fiches contactables').item.json.nbAvis }} avis\nSite web : {{ $('Garder les fiches contactables').item.json.siteWeb }}\nContenu du site : {{ $json.data }}",
        "options": {
          "systemMessage": "Tu qualifies des restaurants comme prospects pour des services d automatisation.\n\nEvalue sur trois criteres : la taille de l etablissement, son activite recente (volume et fraicheur des avis), et sa presence en ligne.\nDonne un score de 1 a 10 : 10 = fort besoin et capacite a payer, 1 = aucun interet.\nIdentifie l angle d offre le plus pertinent et justifie toujours ta note.\nSi le contenu du site est vide ou illisible, considere la presence en ligne comme faible plutot que d inventer."
        }
      }
    },
